# Public client configuration. The Supabase publishable/anon key is safe to expose;
# database access must be protected by RLS policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_APP_NAME=MOOVE
VITE_APP_ENV=development

# Server-only secret. Do not prefix server secrets with VITE_.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# API base URL is empty for a same-origin Vercel deployment.
VITE_API_BASE_URL=
NODE_ENV=development
PORT=8443
